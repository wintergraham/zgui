  }

  /* Benchmarks */
  .bench,
  .docs,
  .features,
  .agents {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    border-top: 1px solid color-mix(in oklab, var(--color-fd-foreground) 8%, transparent);
  }
  .bench-head,
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
