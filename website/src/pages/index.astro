  }
  .btn:hover {
    border-color: color-mix(in oklab, var(--color-fd-foreground) 30%, transparent);
  }
  .btn-primary {
    border-color: transparent;
    background: var(--color-fd-foreground);
    color: var(--color-fd-background);
  }
