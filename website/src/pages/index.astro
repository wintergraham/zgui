  }
  :global(.dark) .sun,
  :global(html:not(.dark)) .moon {
    display: none;
  }
  @media (max-width: 800px) {
    .top-nav {
      display: none;
    }
    .top-docs {
      display: inline-flex;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in oklab, var(--color-fd-foreground) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--color-fd-foreground) 5%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 0%, black, transparent 75%);
  }
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -18rem;
    left: 10%;
    width: 46rem;
    height: 30rem;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-fd-primary) 16%, transparent), transparent);
    filter: blur(20px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2.5rem, 5vw, 5rem);
    align-items: end;
    margin-top: 1.75rem;
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem 0.3rem 0.6rem;
    border: 1px solid color-mix(in oklab, var(--color-fd-foreground) 12%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-fd-background) 70%, transparent);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: border-color 120ms ease;
  }
  .pill:hover {
    border-color: color-mix(in oklab, var(--color-fd-primary) 50%, transparent);
  }
  .pill-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
