    color: var(--color-fd-muted-foreground);
  }
  .facts dd {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .hero-code {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .hero-code :global(.cb) {
    margin: 0;
    border-radius: 0.9rem;
    box-shadow:
