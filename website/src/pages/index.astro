    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-fd-primary) 22%, transparent);
  }
  .pill-sep,
  .pill-muted {
    color: var(--color-fd-muted-foreground);
  }
  h1 {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.042em;
    font-weight: 640;
    text-wrap: balance;
  }
  .lede {
    max-width: 36rem;
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-fd-muted-foreground);
    text-wrap: pretty;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 1.2rem;
    border-radius: 0.625rem;
    border: 1px solid color-mix(in oklab, var(--color-fd-foreground) 14%, transparent);
    background: var(--color-fd-background);
    font-size: 0.9375rem;
