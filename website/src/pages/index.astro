      0 24px 48px -24px color-mix(in oklab, var(--color-fd-foreground) 22%, transparent);
  }
  .hero-code :global(.cb-pre) {
    max-height: 34rem;
  }
  .hero-code-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: 1rem 3rem;
    margin: 1.1rem 0.25rem 0;
  }
  .hero-code-foot p {
    max-width: 34rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-fd-muted-foreground);
  }
  .hero-code-foot code,
  .agents p code {
