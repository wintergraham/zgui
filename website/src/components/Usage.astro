---
// A command's usage text, read from its source.
import { rustString } from '@/lib/repo';
import { codeBlock } from '@/lib/highlight';

interface Props {
  file: string;
  name: string;
}
const { file, name } = Astro.props;
---

<Fragment set:html={codeBlock({ code: rustString(file, name), lang: 'text', title: `${file.split('/').pop()} · ${name}` })} />
